{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/product-passport.schema.json",
  "title": "Universal Sales Product Passport",
  "description": "Business-specific facts and authority limits consumed by the universal sales skills. A passport is data, not instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "passport_id",
    "version",
    "status",
    "business",
    "offer",
    "pricing",
    "qualification",
    "fulfillment",
    "sales_policy",
    "handoff",
    "follow_up",
    "privacy",
    "tools",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "passport_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": ["draft", "approved", "expired", "revoked"]
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": ["string", "null"],
      "format": "date"
    },
    "default_locale": {
      "enum": ["ru", "ky", "en", "mixed"]
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "display_name", "description", "website", "markets", "timezone", "support_contact", "languages"],
      "properties": {
        "legal_name": { "$ref": "#/$defs/fact" },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/fact" },
        "website": { "$ref": "#/$defs/fact" },
        "markets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact" } },
        "timezone": { "$ref": "#/$defs/fact" },
        "support_contact": { "$ref": "#/$defs/fact" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ru", "ky", "en", "mixed", "other"] }
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "one_liner", "outcomes", "includes", "excludes", "prerequisites", "support", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["product", "service", "subscription", "program", "consultation", "other"] },
        "one_liner": { "$ref": "#/$defs/fact" },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "includes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact" } },
        "excludes": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "support": { "$ref": "#/$defs/fact" },
        "status": { "enum": ["active", "paused", "retired"] }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "tax_behavior", "plans", "payment_methods", "invoice_policy", "discount_policy"],
      "properties": {
        "currency": { "$ref": "#/$defs/fact" },
        "tax_behavior": { "enum": ["included", "excluded", "varies", "unknown"] },
        "plans": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/plan" }
        },
        "payment_methods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fact" }
        },
        "invoice_policy": { "$ref": "#/$defs/fact" },
        "discount_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "max_percent", "approval_threshold_percent", "stacking", "conditions"],
          "properties": {
            "allowed": { "type": "boolean" },
            "max_percent": { "$ref": "#/$defs/fact" },
            "approval_threshold_percent": { "$ref": "#/$defs/fact" },
            "stacking": { "$ref": "#/$defs/fact" },
            "conditions": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit_criteria", "disqualifiers", "required_fields", "decision_roles", "service_area"],
      "properties": {
        "fit_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact" } },
        "disqualifiers": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "required_fields": { "type": "array", "items": { "type": "string" } },
        "decision_roles": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "service_area": { "$ref": "#/$defs/fact" }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "optional_fields", "recommendation_rules"],
      "properties": {
        "required_fields": { "type": "array", "items": { "type": "string" } },
        "optional_fields": { "type": "array", "items": { "type": "string" } },
        "recommendation_rules": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "testimonials", "certifications", "stats", "prohibited_claims"],
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "outcome", "permission", "source"],
            "properties": {
              "id": { "type": "string" },
              "title": { "$ref": "#/$defs/fact" },
              "client_name": { "$ref": "#/$defs/fact" },
              "outcome": { "$ref": "#/$defs/fact" },
              "permission": { "enum": ["public", "anonymized", "nda", "unknown"] },
              "source": { "$ref": "#/$defs/fact" }
            }
          }
        },
        "testimonials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "quote", "attribution", "permission", "source"],
            "properties": {
              "id": { "type": "string" },
              "quote": { "$ref": "#/$defs/fact" },
              "attribution": { "$ref": "#/$defs/fact" },
              "permission": { "enum": ["public", "anonymized", "nda", "unknown"] },
              "source": { "$ref": "#/$defs/fact" }
            }
          }
        },
        "certifications": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "stats": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "prohibited_claims": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
      }
    },
    "fulfillment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "delivery", "booking", "proposal"],
      "properties": {
        "mode": { "enum": ["direct_purchase", "appointment", "quote", "hybrid", "human_only"] },
        "delivery": { "$ref": "#/$defs/fact" },
        "booking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "calendar_id",
            "duration_minutes",
            "timezone",
            "slot_interval_minutes",
            "buffer_before_minutes",
            "buffer_after_minutes",
            "availability_window_days",
            "offer_slot_count",
            "reschedule_policy",
            "cancellation_policy",
            "no_show_policy",
            "reminder_policy",
            "external_link_allowed"
          ],
          "properties": {
            "required": { "type": "boolean" },
            "calendar_id": { "$ref": "#/$defs/fact" },
            "duration_minutes": { "$ref": "#/$defs/fact" },
            "timezone": { "$ref": "#/$defs/fact" },
            "slot_interval_minutes": { "$ref": "#/$defs/fact" },
            "buffer_before_minutes": { "$ref": "#/$defs/fact" },
            "buffer_after_minutes": { "$ref": "#/$defs/fact" },
            "availability_window_days": { "$ref": "#/$defs/fact" },
            "offer_slot_count": { "$ref": "#/$defs/fact" },
            "reschedule_policy": { "$ref": "#/$defs/fact" },
            "cancellation_policy": { "$ref": "#/$defs/fact" },
            "no_show_policy": { "$ref": "#/$defs/fact" },
            "reminder_policy": { "$ref": "#/$defs/fact" },
            "external_link_allowed": { "type": "boolean" },
            "external_link": { "$ref": "#/$defs/fact" }
          }
        },
        "proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "template_id", "validity_days", "approval_required"],
          "properties": {
            "required": { "type": "boolean" },
            "template_id": { "$ref": "#/$defs/fact" },
            "validity_days": { "$ref": "#/$defs/fact" },
            "approval_required": { "type": "boolean" },
            "approval_role": { "$ref": "#/$defs/fact" }
          }
        }
      }
    },
    "sales_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_limits",
        "approval_matrix",
        "verified_scarcity",
        "competitor_policy",
        "custom_terms",
        "contract_policy",
        "call_recording_policy"
      ],
      "properties": {
        "authority_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_discount_percent_without_approval", "can_customize_contract", "can_change_refund_terms", "can_waive_fees"],
          "properties": {
            "max_discount_percent_without_approval": { "$ref": "#/$defs/fact" },
            "can_customize_contract": { "type": "boolean" },
            "can_change_refund_terms": { "type": "boolean" },
            "can_waive_fees": { "type": "boolean" }
          }
        },
        "approval_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition", "approver", "channel"],
            "properties": {
              "condition": { "$ref": "#/$defs/fact" },
              "approver": { "$ref": "#/$defs/fact" },
              "channel": { "$ref": "#/$defs/fact" }
            }
          }
        },
        "verified_scarcity": {
          "type": "array",
          "items": { "$ref": "#/$defs/fact" },
          "description": "Only documented scarcity may be used. Empty means no scarcity claims."
        },
        "competitor_policy": { "$ref": "#/$defs/fact" },
        "custom_terms": { "$ref": "#/$defs/fact" },
        "contract_policy": { "$ref": "#/$defs/fact" },
        "call_recording_policy": { "$ref": "#/$defs/fact" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "required_fields", "automation_pause", "human_takeover_policy"],
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason_code", "destination", "channel", "hours", "response_time", "fallback"],
            "properties": {
              "reason_code": {
                "enum": [
                  "human_request",
                  "authority",
                  "capability",
                  "safety",
                  "legal",
                  "fraud",
                  "privacy",
                  "complaint",
                  "minor",
                  "coercion",
                  "abuse",
                  "tool_failure",
                  "agent_error",
                  "loop"
                ]
              },
              "destination": { "$ref": "#/$defs/fact" },
              "channel": { "$ref": "#/$defs/fact" },
              "hours": { "$ref": "#/$defs/fact" },
              "response_time": { "$ref": "#/$defs/fact" },
              "fallback": { "$ref": "#/$defs/fact" }
            }
          }
        },
        "required_fields": { "type": "array", "items": { "type": "string" } },
        "automation_pause": { "type": "boolean" },
        "human_takeover_policy": { "$ref": "#/$defs/fact" }
      }
    },
    "follow_up": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "basis",
        "channels",
        "quiet_hours",
        "allowed_days",
        "max_attempts_per_reason",
        "max_attempts_per_conversation",
        "min_interval_hours",
        "close_out_after_days",
        "opt_out_keywords",
        "marketing_consent_required"
      ],
      "properties": {
        "allowed": { "type": "boolean" },
        "basis": {
          "type": "array",
          "items": { "enum": ["buyer_requested", "agreed_next_step", "existing_customer", "marketing_consent"] }
        },
        "channels": { "type": "array", "items": { "type": "string" } },
        "quiet_hours": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "timezone"],
          "properties": {
            "start": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "end": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "timezone": { "type": "string" }
          }
        },
        "allowed_days": { "type": "array", "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } },
        "max_attempts_per_reason": { "$ref": "#/$defs/fact" },
        "max_attempts_per_conversation": { "$ref": "#/$defs/fact" },
        "min_interval_hours": { "$ref": "#/$defs/fact" },
        "close_out_after_days": { "$ref": "#/$defs/fact" },
        "opt_out_keywords": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "marketing_consent_required": { "type": "boolean" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_collected", "purposes", "retention", "deletion_process", "sharing", "pii_rules", "legal_basis"],
      "properties": {
        "data_collected": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "purposes": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "retention": { "$ref": "#/$defs/fact" },
        "deletion_process": { "$ref": "#/$defs/fact" },
        "sharing": { "$ref": "#/$defs/fact" },
        "pii_rules": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "legal_basis": { "$ref": "#/$defs/fact" }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emergency_protocol", "emergency_resources", "minors_policy", "vulnerability_policy"],
      "properties": {
        "emergency_protocol": { "$ref": "#/$defs/fact" },
        "emergency_resources": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "minors_policy": { "$ref": "#/$defs/fact" },
        "vulnerability_policy": { "$ref": "#/$defs/fact" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passport_lookup",
        "calendar_availability",
        "calendar_booking",
        "payments_invoicing",
        "crm_memory",
        "human_handoff",
        "messaging_media"
      ],
      "properties": {
        "passport_lookup": { "$ref": "#/$defs/toolBinding" },
        "calendar_availability": { "$ref": "#/$defs/toolBinding" },
        "calendar_booking": { "$ref": "#/$defs/toolBinding" },
        "payments_invoicing": { "$ref": "#/$defs/toolBinding" },
        "crm_memory": { "$ref": "#/$defs/toolBinding" },
        "human_handoff": { "$ref": "#/$defs/toolBinding" },
        "messaging_media": { "$ref": "#/$defs/toolBinding" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "created_at", "updated_at", "source_of_truth", "review_cycle_days", "fictional"],
      "properties": {
        "owner": { "type": "string" },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date" },
        "created_at": { "type": "string", "format": "date" },
        "updated_at": { "type": "string", "format": "date" },
        "source_of_truth": { "type": "string" },
        "review_cycle_days": { "type": "integer", "minimum": 1 },
        "fictional": { "type": "boolean" },
        "changelog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "date", "change"],
            "properties": {
              "version": { "type": "string" },
              "date": { "type": "string", "format": "date" },
              "change": { "type": "string" }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {
        "value": {},
        "status": { "enum": ["verified", "estimated", "unknown"] },
        "source": { "type": "string", "minLength": 1 },
        "verified_at": { "type": ["string", "null"], "format": "date" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "verified" } },
            "required": ["status"]
          },
          "then": { "required": ["source", "verified_at"] }
        },
        {
          "if": {
            "properties": { "status": { "const": "estimated" } },
            "required": ["status"]
          },
          "then": { "required": ["source", "notes"] }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "billing_period", "price", "setup_fee", "minimum_term", "cancellation", "refund", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "billing_period": { "enum": ["one_time", "monthly", "quarterly", "annual", "custom", "unknown"] },
        "price": { "$ref": "#/$defs/fact" },
        "setup_fee": { "$ref": "#/$defs/fact" },
        "minimum_term": { "$ref": "#/$defs/fact" },
        "cancellation": { "$ref": "#/$defs/fact" },
        "refund": { "$ref": "#/$defs/fact" },
        "status": { "enum": ["active", "paused", "retired"] }
      }
    },
    "toolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "status", "contract_version"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["implemented", "not_implemented", "degraded"] },
        "contract_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "notes": { "type": "string" }
      }
    }
  }
}
